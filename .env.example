# AI provider: ollama (default) | openai | none (heuristics only)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=gpt-oss:20b
LOCAL_CHAT_MODEL=gemma3:12b
LOCAL_LLM_MODEL_HEAVY=gpt-oss:120b
LOCAL_VISION_MODEL=qwen2.5vl:7b
LOCAL_EMBED_MODEL=nomic-embed-text
# Used when a configured model is not pulled yet
LOCAL_LLM_FALLBACKS=gemma3:12b,qwen3.6:35b-a3b
LOCAL_HEAVY_FALLBACKS=gemma3:12b,qwen3.6:35b-a3b
LOCAL_VISION_FALLBACKS=gemma3:12b

# Speech (optional; packages in backend/requirements-optional.txt)
STT_MODEL=large-v3-turbo
LOCAL_TTS_VOICE=bf_emma

# Optional hosted provider (AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# NLB Catalogue API keys (per-branch availability, call numbers, checkout trends)
NLB_API_KEY=
NLB_APP_CODE=

# 1 = serve cached reading paths only, no network
DEMO=0

# data.gov.sg API key (optional; lifts rate limits for NLB open datasets)
DATAGOV_API_KEY=

# Shelf data source: auto | demo | dataset | api
#   auto    = api when both NLB keys are set, else dataset when backend/data/nlb/ has data, else demo
#   demo    = the built-in table only
#   dataset = NLB open data (opening hours, all-of-NLB loans) + the built-in table for per-title copies
#   api     = NLB Catalogue v2 (falls back to dataset, then demo, without the keys)
# The Settings sheet (Shelf data) overrides it at runtime.
DATA_SOURCE=auto
